---
import { site } from '../../data/site';
import PhotoSlideshow from '../ui/PhotoSlideshow.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const lifestylePhotos = [
  { src: '/assets/images/lifestyle-cyprus.jpg', alt: 'Ronan in Cyprus' },
  { src: '/assets/images/lifestyle-flowers.jpg', alt: 'Flowers' },
  { src: '/assets/images/lifestyle-kirremuir.jpg', alt: 'Ronan in Kirriemuir' },
];
---

<section id="about" class="section section-tinted">
  <div class="container">
    <SectionHeading title="About" />

    <div class="grid md:grid-cols-5 gap-12 items-start">

      <!-- Bio -->
      <div class="md:col-span-3 space-y-5 text-[var(--color-text-muted)] leading-relaxed reveal">
        <p>
          I'm a Full Stack Developer at Twizzit and a software engineer based in Glasgow. I bring
          four years of previous full-time industry experience from <a href="https://www.leidos.com" target="_blank" rel="noopener noreferrer" class="subtle-link">Leidos</a>,
          completed alongside a BSc (Hons) in Software Engineering with Human-Computer Interaction
          at the University of Glasgow through the Graduate Apprenticeship route.
        </p>
        <p>
          At Twizzit, I contribute across frontend and backend systems throughout the software
          development lifecycle, from shaping solutions and implementation through code review,
          testing, production delivery, and ongoing support. At Leidos, my work spanned
          public-sector product development, cybersecurity, legacy modernisation, and maritime autonomy R&amp;D.
        </p>
        <p>
          Outside of work I build personal projects to explore areas that interest me - most
          are on <a href={site.github} target="_blank" rel="noopener noreferrer" class="subtle-link">GitHub</a>.
          I'm also a certified STEM Ambassador and enjoy getting into schools to work with
          pupils on technology and computing.
        </p>
      </div>

      <!-- Slideshow -->
      <div class="md:col-span-2 reveal" style="transition-delay: 0.15s;">
        <PhotoSlideshow photos={lifestylePhotos} />
      </div>

    </div>

  </div>
</section>

<style>
  .subtle-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-text-faint);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.2s ease;
  }
  .subtle-link:hover {
    text-decoration-color: var(--color-accent);
  }
</style>
